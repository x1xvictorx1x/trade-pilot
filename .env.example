TRADE_PILOT_MARKET_PORT=8787

# Supabase public browser config for auth/database.
# These are safe anon/public keys, protected by Supabase RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Also accepted by this Vite app for compatibility with Supabase's Next.js setup guide.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Future Tradovate read-only market data settings.
# Do not expose these in browser code.
TRADOVATE_ENV=demo
TRADOVATE_APP_ID=TradePilot
TRADOVATE_APP_VERSION=0.1.0
TRADOVATE_DEVICE_ID=trade-pilot-local
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_USERNAME=
TRADOVATE_API_PASSWORD=

# Optional separate live read-only credentials.
TRADOVATE_LIVE_APP_ID=TradePilot
TRADOVATE_LIVE_APP_VERSION=0.1.0
TRADOVATE_LIVE_DEVICE_ID=trade-pilot-local
TRADOVATE_LIVE_CID=
TRADOVATE_LIVE_SEC=
TRADOVATE_LIVE_USERNAME=
TRADOVATE_LIVE_API_PASSWORD=

# Optional local broker bridge token. Keep this server-side.
# A future platform bridge can post read-only position/fill snapshots to:
# POST http://127.0.0.1:8787/api/broker/sync
TRADE_PILOT_BROKER_BRIDGE_TOKEN=

# Required before saving user-owned broker credentials.
# Set this only in server/Vercel environment variables, never in browser code.
TRADE_PILOT_BROKER_ENCRYPTION_KEY=

# Tradovate read-only integration prep.
# Never expose these values to frontend/browser code.
# Order placement remains disabled.
